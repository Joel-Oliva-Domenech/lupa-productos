{
  "name": "lupa-productos",
  "version": "1.1.0",
  "description": "PWA libre para escanear productos y entender sus datos alimentarios sin una nota simplista.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/generate-assets.cjs",
    "check": "pnpm test && pnpm build",
    "desktop": "pnpm build && electron .",
    "desktop:smoke": "pnpm build && electron . --smoke-test",
    "desktop:pack": "pnpm build && electron-builder --dir --publish never",
    "desktop:dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "desktop:dist:mac:x64": "pnpm build && electron-builder --mac --x64 --publish never",
    "desktop:dist:mac:arm64": "pnpm build && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "5.0.4",
    "@zxing/browser": "^0.2.1",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "main": "electron/main.cjs",
  "author": "Joel Oliva"
}
